# Active Verification Environment Configuration

# Server Settings
APP_NAME=ActiveVerification
APP_ENV=production
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Ingestion Settings
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_POLL_INTERVAL_SECONDS=30

IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=30

# Sandboxed Active Verification
# STRICT SAFETY RULE: Sandbox mode must ALWAYS be enabled.
# Real network communication to senders is strictly blocked.
ACTIVE_VERIFICATION_SANDBOX_STRICT=true
MAX_SYNTHETIC_INTERACTION_TURNS=3

# LLM Judge & Content Model
LLM_PROVIDER=gemini
LLM_API_KEY=
DEBERTA_MODEL_NAME=microsoft/deberta-v3-small
ENABLE_LOCAL_TRANSFORMER=true

# Decision Engine Thresholds (Tuned for ~1% Target False Positive Rate)
QUARANTINE_THRESHOLD=0.88
WARN_THRESHOLD=0.55
TARGET_FPR=0.01

# Privacy
PRIVACY_SALT=change-this-in-production-salt-key
HASH_PII_ENABLED=true
STORE_RAW_BODIES=false

